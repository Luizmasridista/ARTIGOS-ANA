# Bindagem web blindada — copie para .env.web e ajuste
# Uso: powershell -File run-web.ps1  (lê este arquivo)

# Segredo JWT 32+ bytes (gere com: openssl rand -hex 32  ou  [guid]::NewGuid())
JWT_SECRET=coloque-aqui-32-bytes-minimo-aleatorio-forte-123456

# Postgres local (dev) — use PGHOST/PGPASSWORD etc
PGPASSWORD=senha-forte-aqui
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGDATABASE=artigos_ana
# Neon Free (prod/Render): DATABASE_URL tem precedencia sobre PGHOST etc
# Exemplo: postgres://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
# No Render, defina DATABASE_URL como env sync:false (não commitar)
# DATABASE_URL=postgres://USER:PASS@EP.neon.tech/artigos_ana?sslmode=require

# CORS estrito: lista fechada de origens https permitidas
# Para LAN https com cert self-signed, adicione https://SEU_LAN_IP:8734
ALLOWED_ORIGIN=https://localhost:8734,https://127.0.0.1:8734,https://192.168.0.19:8734
# GROK opcional (https tunnel): descomente e coloque sua URL grok
# GROK_ORIGIN=https://abc123.grok.io

# Bindagem rede (Render exige BIND_ADDR=0.0.0.0 e PORT=10000 via env PORT)
BIND_ADDR=0.0.0.0
PORT=8734
# Em Render Free, PORT é injetado como 10000 (main.go lê env PORT); mantenha BIND_ADDR=0.0.0.0

# TLS direto (blindagem captura passiva na LAN)
TLS_CERT=certs/server.crt
TLS_KEY=certs/server.key

# Strict CORS extra
STRICT_CORS=1

# Para desktop local sem TLS, use ALLOW_INSECURE_COOKIE=1 apenas em dev
# ALLOW_INSECURE_COOKIE=1
